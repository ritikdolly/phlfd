# ─────────────────────────────────────────────────────────────
# Savoria Restaurant Frontend — Environment Variables Reference
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8080/api

# WebSocket server URL (used by RealTimeContext for SockJS/STOMP)
VITE_WS_URL=http://localhost:8080

# Google OAuth2 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay publishable key
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
